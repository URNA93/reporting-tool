# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Access policy
REPORTING_COMPANY_DOMAIN=@your-company.example
REPORTING_MASTER_ADMIN_EMAIL=admin@example.com

# Google Sheets synchronisation (optional; leave both unset to disable it)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=replace_with_a_long_random_secret
GOOGLE_SHEETS_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/your-spreadsheet-id/edit
